# 调试模式会把 Node.js 安装到脚本目录下的 nodejs/
# 属运行时产物，不应提交
nodejs/

# 调试模式会把 dsh 隔离安装到脚本目录 (npm install -g --prefix 脚本目录)
node_modules/

# 下载的压缩包 (node-v*.zip/tar.gz 等运行时产物)
*.zip
*.tar.gz
*.tgz

# 服务安装时生成的 dsh web 运行包装脚本 (含本机绝对路径, 每次 install 重建)
server/run-dsh-web.cmd
server/run-dsh-web.vbs
server/run-dsh-web.ps1

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

dsh*
nrm*
